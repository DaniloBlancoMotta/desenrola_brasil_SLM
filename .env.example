# Copie para .env e preencha com sua chave da Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Modelo com suporte a tool calling. llama-3.3-70b-versatile e
# llama-3.1-8b-instant foram depreciados pela Groq em jun/2026.
GROQ_MODEL=openai/gpt-oss-120b

# Caminho do CSV dentro do container (montado a partir de ./data)
CSV_PATH=/data/bacen_data.csv
